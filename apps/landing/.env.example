# Where the studio app lives. The landing's "Criar conta" and "Entrar" buttons point here.
# Public on purpose (it is a link in the page). The landing has no other settings and no secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# The landing's own public address (canonical URL, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Footer links the business provides. Leave a variable empty and its link is not shown.
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
