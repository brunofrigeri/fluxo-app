# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY


# Needed only to invite other users (Authentication > Users > Invite also works, but the
# in-app "Convidar usuário" screen uses this instead). Never prefix it with NEXT_PUBLIC_ —
# that would ship it to the browser. Server-side only, used in src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Wellhub (Gympass). Leave all three empty and the integration stays off.
# WELLHUB_API_TOKEN is the token Wellhub issues to Fluxo as a system (a Wellhub partnership; never
# a studio's login and never copied from another product). Server-side only, never NEXT_PUBLIC_.
WELLHUB_API_TOKEN=
# "sandbox" (default) or "production".
WELLHUB_ENV=sandbox
# The Wellhub custom-field key that carries the studio's connection code. Wellhub fixes it per system.
WELLHUB_CODE_FIELD=cms_id
