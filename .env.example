# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY


# Needed only to invite other users (Authentication > Users > Invite also works, but the
# in-app "Convidar usuário" screen uses this instead). Never prefix it with NEXT_PUBLIC_ —
# that would ship it to the browser. Server-side only, used in src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
