{
  "name": "fluxo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.1",
  "scripts": {
    "dev": "turbo run dev --filter=@fluxo/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "npm run check:boundaries && turbo run test",
    "e2e:local": "npm run e2e:local -w @fluxo/web --",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
